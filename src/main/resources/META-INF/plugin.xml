<idea-plugin>
    <id>org.jetbrains.plugins.compose.template</id>
    <name>Compose Template Example</name>
    <vendor url="https://www.yourcompany.com">YourCompany</vendor>

    <depends>com.intellij.modules.compose</depends>

    <resource-bundle>messages.ComposeTemplateBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                factoryClass="org.jetbrains.plugins.template.toolWindow.ComposeSamplesToolWindowFactory"
                icon="org.jetbrains.plugins.template.ComposeIcons.ComposeToolWindow"
                id="ComposeSamples"/>

        <applicationService
                serviceInterface="org.jetbrains.plugins.template.repository.settings.SettingsService"
                serviceImplementation="org.jetbrains.plugins.template.repository.settings.SettingsServiceImpl"/>

        <applicationService
                serviceInterface="org.jetbrains.plugins.template.repository.github_models.GithubModelsService"
                serviceImplementation="org.jetbrains.plugins.template.repository.github_models.GithubModelsServiceImpl"/>

        <applicationConfigurable
                id="com.example.chatai.settings"
                key="settings.display.name"
                instance="org.jetbrains.plugins.template.settings.SettingsConfigurable"/>
    </extensions>
</idea-plugin>
